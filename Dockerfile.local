# marola-local — MIP-0008 §5.3: Ollama with `marola-llama3.2` (finetune/Modelfile, Tier 1, no
# weight change) already in its store, so no pull and no `ollama create` on the user's machine.
# docker-local.yml moves ghcr.io/marola-dev/marola-ml:local only after scripts/benchmark_gate.py passes.
# Bump the tag here and in marola's docker-compose.yml together.
FROM ollama/ollama:0.33.3

# The model store goes to a path of our own rather than /root/.ollama, so nothing depends on
# whether the base image declares that directory a volume (files written under a declared
# volume during a build are discarded).
ENV OLLAMA_MODELS=/models
COPY finetune/Modelfile /finetune/Modelfile

# `ollama pull`/`create` talk to a server: run one for the duration of this layer. The benchmark
# embeds with nomic-embed-text: Ollama only serves /api/embed for a GGUF that declares
# <arch>.pooling_type, and llama3.2 does not (a 501). It adds ~270 MB to the image.
RUN (ollama serve > /tmp/ollama-build.log 2>&1 &) \
 && for _ in $(seq 1 60); do ollama list >/dev/null 2>&1 && break; sleep 1; done \
 && ollama pull llama3.2 \
 && ollama pull nomic-embed-text:v1.5 \
 && ollama create marola-llama3.2 -f /finetune/Modelfile \
 && ollama list \
 && rm -f /tmp/ollama-build.log

EXPOSE 11434
HEALTHCHECK --interval=5s --timeout=5s --retries=12 CMD ["ollama", "list"]
# ENTRYPOINT/CMD inherited: `ollama serve`.
